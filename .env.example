# ── App ──────────────────────────────────────────────────────────────────
# Required. Copy this file to .env, then run `php artisan app:install`
# (generates APP_KEY, migrates, creates the first admin). See README.md.
APP_NAME="Next Template API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

# Optional. Only read by `php artisan app:install --force` (non-interactive
# installs, e.g. CI/containers). Ignored by the interactive prompts.
# APP_INSTALL_ADMIN_NAME=Admin
# APP_INSTALL_ADMIN_EMAIL=admin@example.com
# APP_INSTALL_ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────
# Required. sqlite needs no server (file-based, good for local dev).
# For MySQL/Postgres, set DB_CONNECTION and uncomment the rest below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=maktech_laravel_api
# DB_USERNAME=root
# DB_PASSWORD=

# ── Session ──────────────────────────────────────────────────────────────
# Required.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Broadcasting (Reverb) ────────────────────────────────────────────────
# Required for realtime features (audit screen, notifications). Reverb is
# a separate repo/process (next-template-reverb) — run it alongside this API.
BROADCAST_CONNECTION=reverb

# Shared with next-template-reverb (source of truth) and NEXT_PUBLIC_REVERB_* on Next.
# Diagnostic events use ShouldBroadcastNow (no queue worker required).
# Product events that implement ShouldBroadcast need `php artisan queue:work`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# ── Filesystem & Queue ───────────────────────────────────────────────────
# Required. Queue needs Redis running (see Redis section below) and at
# least one worker: `php artisan queue:work`.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Transcodes and backups outlive the default 90s retry_after, so on redis they
# use redis-media / redis-backups. Override only if you change the workers too.
# MEDIA_QUEUE_CONNECTION=redis-media
# MEDIA_QUEUE_RETRY_AFTER=7300
# BACKUP_QUEUE_CONNECTION=redis-backups
# BACKUP_QUEUE_RETRY_AFTER=3700

# ── Cache ────────────────────────────────────────────────────────────────
# Required.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ── Redis ────────────────────────────────────────────────────────────────
# Required (backs cache, queue, sessions if configured). Install Redis
# locally or use a managed instance; see README.md for options.
REDIS_CLIENT=phpredis
# Prefer REDIS_URL for Coolify / managed Redis. Discrete vars are the fallback.
# Example: redis://default:password@127.0.0.1:6379/0
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ── Mail ─────────────────────────────────────────────────────────────────
# Required. `log` writes mail to the log instead of sending (fine for
# local dev). Switch to smtp/resend/ses/postmark for real delivery.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── S3 / object storage (optional) ──────────────────────────────────────
# Optional. Only needed if FILESYSTEM_DISK or MEDIA_DISK is set to s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Frontend / BFF trust (required) ─────────────────────────────────────
# Browser origins allowed to use this API through the Next.js BFF.
# Comma-separated. FRONTEND_URL is the single-origin fallback.
# CORS and EnsureTrustedBff both read this list. The browser never calls
# this API directly; the BFF sends the page origin in X-Frontend-Origin.
FRONTEND_URLS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Shared secret the Next.js server sends as X-BFF-Secret. Required.
# Generate with: openssl rand -base64 32
# Must match BFF_SECRET on the Next.js app. Do not put the production
# value on Vercel preview deployments.
BFF_SECRET=

# Next.js route that drops cached SEO data after changes made outside a Next
# request. Leave empty until that route is deployed (the call is a no-op).
FRONTEND_REVALIDATE_URL=

# Distinctive token that must match SEO_SCANNER_UA_TOKEN on the Next.js app.
# Baked into the user agent the SEO health scanner sends, so Next.js
# streams full <head> metadata to it instead of an empty shell. Changing
# one side without the other silently breaks SEO health scanning.
# SEO_SCANNER_USER_AGENT=Mozilla/5.0 (compatible; TemplateSeoScanner/1.0)

# ── SEO health scanning (optional module) ───────────────────────────────
# SEO jobs (files, path probes, audits) run on their own connection, whose
# retry_after stays above the 900-second audit timeout. Run a worker for it:
#   php artisan queue:work redis-seo --queue=seo --tries=1 --timeout=900
SEO_QUEUE_CONNECTION=redis-seo
SEO_QUEUE=seo
SEO_QUEUE_RETRY_AFTER=960

# ── Sanctum & search (Scout) ────────────────────────────────────────────
# Optional prefix on new Sanctum tokens so secret scanners can spot leaks,
# e.g. "nexttemplate_". Tokens live in personal_access_tokens; no keys to manage.
SANCTUM_TOKEN_PREFIX=

VITE_APP_NAME="${APP_NAME}"

# Scout. collection/null needs no search engine (Eloquent LIKE fallback).
# Production: typesense | meilisearch | algolia | turbopuffer, then
# `php artisan scout:import-all --fresh` (not on container boot).
SCOUT_DRIVER=collection
SCOUT_QUEUE=true
SCOUT_PREFIX=nexttemplate_
SCOUT_HIT_LIMIT=1000

TYPESENSE_API_KEY=
TYPESENSE_HOST=typesense.next.maktechlaravel.cloud
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_PATH=

MEILISEARCH_HOST=https://mailisearch.next.maktechlaravel.cloud
MEILISEARCH_KEY=

ALGOLIA_APP_ID=
ALGOLIA_SECRET=
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=gcp-us-central1

# ── Media / HLS video (optional module) ─────────────────────────────────
# HLS uploads. tusd runs inside this container at /tus/. The browser sends
# bytes there; PHP only receives localhost hooks.
# Generate with: openssl rand -hex 32
TUS_HOOK_SECRET=
# Optional. Defaults to APP_URL + /tus/
# TUS_PUBLIC_ENDPOINT=https://api.next.maktechlaravel.cloud/tus/
VIDEO_MAX_UPLOAD_BYTES=8589934592
FFMPEG_BINARIES=/usr/bin/ffmpeg
FFPROBE_BINARIES=/usr/bin/ffprobe
MEDIA_DISK=public
# Local Windows encode: set these to ffmpeg and ffprobe on PATH.
# Docker already provides /usr/bin/ffmpeg. Tests mock the encoder.

# ── Backups (optional module) ────────────────────────────────────────────
# Database backups (spatie/laravel-backup). Archives go to the `backups`
# disk, storage/app/private/backups/<BACKUP_NAME>/, on the storage volume.
# Keep BACKUP_NAME fixed; changing it hides the existing backups.
# Backups need mysqldump/mysql (MySQL), or sqlite3 (SQLite), plus gzip.
# The Docker image ships them. See docs/backups.md.
BACKUP_NAME=next-template-api
# Optional. Encrypts every archive with AES-256. Losing it makes the
# archives unreadable, so store it outside this server too.
BACKUP_ARCHIVE_PASSWORD=
# Optional. Failure and unhealthy-backup mail goes here; empty sends nothing.
BACKUP_NOTIFICATION_EMAIL=
BACKUP_SCHEDULE_TIME=00:00
BACKUP_SCHEDULE_TIMEZONE=Asia/Dhaka
BACKUP_MAX_MB=5000

# ── Optional modules ─────────────────────────────────────────────────────
# Unset = enabled. Set to "false" to stop a module's scheduled jobs here,
# and set the matching NEXT_PUBLIC_MODULE_* to "false" on the Next.js app
# to hide its admin UI too. Keep both sides in sync.
# MODULE_MEDIA=false
# MODULE_BACKUPS=false
# MODULE_SEO_HEALTH=false
# MODULE_AUDIT=false
# MODULE_REALTIME=false

# ── Audit log (optional module) ──────────────────────────────────────────
# Audit log (spatie/laravel-activitylog). Retention is set in the admin under
# Application settings > General (30-730 days). See docs/audit.md.
ACTIVITYLOG_ENABLED=true
AUDIT_PRUNE_TIME=02:00
AUDIT_PRUNE_TIMEZONE=Asia/Dhaka
# Live audit screen updates (queued broadcast on the default queue).
AUDIT_BROADCAST=true
AUDIT_EXPORT_MAX_ROWS=50000
